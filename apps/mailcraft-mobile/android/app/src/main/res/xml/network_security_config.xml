<?xml version="1.0" encoding="utf-8"?>
<!-- Which CAs Android's trust store vouches for when MailCraft asks it (a server Mozilla's roots
     don't know: crates/net/src/stream/trust/android.rs): the system's alone. Never those a person,
     an app or a VPN installed (the owner's decision): a CA installed there can read the mail on
     the way. Never cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
